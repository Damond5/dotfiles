+export function parseImageBackground(value: string | undefined | null): ImageBackground | null {
+  if (!value) return null;
+  const normalized = value.replace(/['"]/g, "").trim().toLowerCase();
+  if (normalized === "transparent" || normalized === "opaque" || normalized === "auto") {
+    return normalized;
+  }
+  throw new Error(`Invalid background: ${value}. Expected transparent|opaque|auto.`);
+}
+
+export function parseOpenAIQuality(value: string | undefined | null): OpenAIQuality | null {
+  if (!value) return null;
+  const normalized = value.replace(/['"]/g, "").trim().toLowerCase();
+  if (
+    normalized === "low" ||
+    normalized === "medium" ||
+    normalized === "high" ||
+    normalized === "xhigh" ||
+    normalized === "max" ||
+    normalized === "auto"
+  ) {
+    return normalized;
+  }
+  throw new Error(`Invalid openaiQuality: ${value}. Expected low|medium|high|xhigh|max|auto.`);
+}
