{
  "env": {
    "MEMORY_ENGINE": "/home/nikv/.claude/tools/memory/memory.py"
  },
  "permissions": {
    "blockReadsOutsideWorkingDirectories": false,
    "additionalDirectories": [
      "/tmp",
      "/home/nikv/.config/agents"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|worker_permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh Notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh Stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh Question"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-bash-file-writes.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/tools/memory/memory_hook.py",
            "timeout": 5,
            "statusMessage": "Recalling memory..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/tools/memory/memory_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/tools/memory/memory_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "enableArtifact": false,
  "disableWorkflows": true,
  "deniedMcpServers": [
    { "serverName": "claude.ai Claude Docs" },
    { "serverName": "claude.ai Figma" },
    { "serverName": "claude.ai Tally" },
    { "serverName": "claude.ai BankMCP" }
  ],
  "skillOverrides": {
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "workflow-authoring": "off",
    "dataviz": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:xlsx": "user-invocable-only",
    "anthropic-skills:pdf": "user-invocable-only",
    "anthropic-skills:google-workspace": "user-invocable-only",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "schedule": "user-invocable-only",
    "loop": "user-invocable-only",
    "update-config": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "claude-in-chrome": "user-invocable-only",
    "run": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only"
  },
  "feedbackDrafts": "off",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "allowWrite": [
        "/tmp/**",
        "/home/nikv/.config/agents/**"
      ],
      "allowRead": [
        "/home/nikv/.claude/tools/**"
      ]
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "auto"
}
