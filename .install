  mermaid-cli
  xan
)
paru -S --needed --noconfirm "${SCRIPTS_PKGS[@]}" "${LAUNCHER_PKGS[@]}" "${UTILS_PKGS[@]}"
rustup install stable
cargo install rusti-cal

## theme
THEME_PKGS=(
  gnome-themes-extra
  papirus-icon-theme
  vimix-cursors
  ttf-roboto
  ttf-roboto-mono
  # lxappearance-gtk3
  # kvantum
  qt5ct
  qt6ct
  adwaita-qt5-git
  adwaita-qt6-git
)
paru -S --needed --noconfirm "${THEME_PKGS[@]}"
if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark
fi


# DEVELOPMENT
DEV_PKGS=(
  base-devel
  rust-analyzer
  mold
  ctags
  uv
  ruff
  python-lsp-server
  dart
  fvm
  lldb
  bash-language-server
  bun
  yaml-language-server
  bear
