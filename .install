  WORK_FLATPAKS=(
    org.cloudcompare.CloudCompare
  )
  paru -S --needed --noconfirm "${WORK_PKGS[@]}"
  flatpak install -y "${WORK_FLATPAKS[@]}"
  if [[ -n ${DISPLAY:-} ]]; then
    xhost +si:localuser:$USER
  fi

  ## nordbo vpn (tailscale via self-hosted headscale)
  sudo systemctl enable tailscaled
  sudo systemctl start tailscaled
  if [[ $update_only == false ]] then
    if tailscale status &>/dev/null; then
      echo "Tailscale already registered"
    else
      echo "Create a pre-auth key at headscale.nordbo.io/admin (Pre-Auth Keys)."
      echo "IMPORTANT: leave tags empty, or the node is owned by tagged-devices and gets no network access."
      hskey=
      read -rsp "Headscale pre-auth key (blank to skip): " hskey || true
      echo
      if [[ -n $hskey ]] then
        sudo tailscale up --login-server=https://headscale.nordbo.io --authkey="$hskey" --accept-routes --accept-dns
        unset hskey
        tailscale status | head -1
      else
        echo "Skipped. Run later:"
        echo "  sudo tailscale up --login-server=https://headscale.nordbo.io --authkey=<key> --accept-routes --accept-dns"
      fi
    fi
  fi

  ## universal robots
  bun install -g @devcontainers/cli
  fish -c 'fish_add_path ~/.bun/bin'

  ## virtual machine

  # google drive
  if [[ $update_only == false ]] then
    opam init
    opam update
    opam install depext
    opam depext google-drive-ocamlfuse
    opam install google-drive-ocamlfuse
  fi
fi
