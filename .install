)
paru -S --needed --noconfirm "${DESKTOP_PKGS[@]}"
# fixes long gtk app startup (dbus timeout)
flatpak install -y "${DESKTOP_FLATPAKS[@]}"
sudo systemctl enable tor

## scripts
SCRIPTS_PKGS=(
  pv
  pigz
)

## launcher
LAUNCHER_PKGS=(
  rofi
)

## modern utils
