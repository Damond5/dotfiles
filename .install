  entr
)
paru -S --needed --noconfirm "${DEV_PKGS[@]}"

## android
curl -fsSL https://dl.google.com/android/cli/latest/linux_x86_64/install.sh | bash


# AI
AI_PKGS=(
  opencode
  # openspec
  agent-browser-bin
  xorg-server-xvfb   # virtual display for agent-driven GUIs (RoboDK)
)
paru -S --needed --noconfirm "${AI_PKGS[@]}"
# OpenCode server: tailnet-only bind + boot-to-login-screen unit (phone web via `opencode pair --url http://gamer:49374`)
if tailscale status &>/dev/null; then
  opencode service set hostname "$(tailscale ip -4)"
fi
sudo cp ~/.config/opencode/opencode.service /etc/systemd/system/opencode.service
sudo systemctl daemon-reload
sudo systemctl enable --now opencode.service
agent-browser install
bunx skills add vercel-labs/agent-browser -y -g
bunx skills add https://github.com/jimliu/baoyu-skills --skill baoyu-image-gen -g -y
# re-apply local OpenAI patches: --background + --openaiQuality (wiped by `skills update`)
patch -N -s -d ~/.agents/skills/baoyu-image-gen -p1 < ~/.config/baoyu-image-gen/openai-background-quality.patch || echo "baoyu-image-gen OpenAI patch did not apply cleanly"

# LOCAL LLM (Qwen3.6-35B-A3B via llama.cpp Vulkan, OpenCode provider "llamacpp")
~/.local/bin/setup-qwen36.sh


# # MEDIA
# paru -S --needed --noconfirm nfs-utils
# paru -S --needed --noconfirm mariadb
# sudo systemctl enable mysqld
# mysql -e "CREATE USER 'kodi' IDENTIFIED BY 'kodi';"
# mysql -e "GRANT ALL ON *.* TO 'kodi';"
# mysql -e "flush privileges;"
# paru -S --needed --noconfirm kodi
# mkdir -p ~/Videos/movies
# mkdir -p ~/Videos/shows
# sudo mkdir -p /srv/nfs/videos
# sudo su -c "echo \n >> /etc/fstab"
# sudo su -c "echo /home/nikv/Videos /srv/nfs/videos none defaults,bind 0 0 >> /etc/fstab"

if [[ $gaming == true ]] then
  # GAMING
  GAMING_PKGS=(
    gamemode
    lib32-gamemode
    mangohud
    gamescope
    lib32-vulkan-radeon
    lib32-vulkan-mesa-layers
    # aur, really needed?
    # amdvlk
    # lib32-amdvlk
    protontricks
    ## steam
    steam-native-runtime
    linux-steam-integration
    ## wine
    dxvk-bin
    lib32-vkd3d
    vkd3d
    wine-staging
    wine-gecko
    wine-mono
    wine-nine
    winetricks
    ## lutris
    lutris
    # no longer exists?
    # lutris-battlenet-meta
    lutris-wine-meta
    # out of date?
    # lutris-world-of-warcraft-dependencies-nvidia
    umu-launcher
    qpdf
    cups
    cups-filters
    samba
    lib32-nvidia-utils
    ## heroic
    heroic-games-launcher-bin
    ethtool
    ## Android SDK (for building and running on real device)
    jdk17-openjdk
    android-sdk-cmdline-tools-latest
    android-sdk-platform-tools
    android-sdk-build-tools
  )
  GAMING_FLATPAKS=(
    com.vysp3r.ProtonPlus
    # com.usebottles.bottles
  )
  paru -S --needed --noconfirm "${GAMING_PKGS[@]}"
  flatpak install -y "${GAMING_FLATPAKS[@]}"

  ## appimages
  # install_appimage WowUp WowUp WowUp
  # install_appimage RPGLogs Uploaders-warcraftlogs Warcraft-Logs-Uploader
  # curl -fLo ~/Applications/curseforge-latest-linux.zip https://curseforge.overwolf.com/downloads/curseforge-latest-linux.zip --create-dirs
  # cd ~/Applications
  # unzip curseforge-latest-linux.zip
  # rm curseforge-latest-linux.zip
  # cd

  # WAKE-ON-LAN (let LAN Pi wake this PC via enp8s0, from S5 or suspend)
  # BIOS still needs: ErP Disabled, Power On By PCI-E Enabled.
  sudo tee /etc/systemd/system/wol-enp8s0.service >/dev/null <<'EOF'
[Unit]
Description=Enable WoL on enp8s0
After=network.target
[Service]
Type=oneshot
ExecStart=/usr/bin/ethtool -s enp8s0 wol g
[Install]
WantedBy=multi-user.target
EOF
  sudo systemctl enable wol-enp8s0.service
  sudo ethtool -s enp8s0 wol g || true

  ## Android SDK (for building and running on real device)
  sudo archlinux-java set java-17-openjdk
  sudo chown -R "$USER:$USER" /opt/android-sdk
  # Set environment variables for session (persistence handled in .profile)
  export ANDROID_HOME=/opt/android-sdk
  export PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/build-tools/latest/bin
  # Accept licenses (auto-accept).
  # `yes` dies of SIGPIPE once licenses are accepted, so only sdkmanager's
  # status matters (pipefail is off for this pipeline).
  set +o pipefail
  yes | sdkmanager --licenses
  licenses_rc=${PIPESTATUS[1]}
  set -o pipefail
  if [[ $licenses_rc -ne 0 ]]; then
    echo "Failed to accept Android SDK licenses" >&2
    exit 1
  fi
  # Install default platform
  if ! sdkmanager "platforms;android-34"; then
    echo "Failed to install Android platform 34" >&2
    exit 1
  fi

  # LOGIN
  sudo cp ~/.config/monitors.xml /var/lib/gdm/.config/
fi


if [[ $portable == true ]] then
  # PORTABLE
  PORTABLE_PKGS=(
    battop
    tlp
    tlp-rdw
  )
  paru -S --needed --noconfirm "${PORTABLE_PKGS[@]}"
  sudo systemctl enable tlp.service
  sudo systemctl mask systemd-rfkill.service
  sudo systemctl mask systemd-rfkill.socket
  sudo sd "#START_CHARGE_THRESH_BAT0=75" "START_CHARGE_THRESH_BAT0=75" /etc/tlp.conf
  sudo sd "#STOP_CHARGE_THRESH_BAT0=80" "STOP_CHARGE_THRESH_BAT0=80" /etc/tlp.conf
  sudo sd "#START_CHARGE_THRESH_BAT1=75" "START_CHARGE_THRESH_BAT1=75" /etc/tlp.conf
  sudo sd "#STOP_CHARGE_THRESH_BAT1=80" "STOP_CHARGE_THRESH_BAT1=80" /etc/tlp.conf
  sudo sd "#RESTORE_THRESHOLDS_ON_BAT=1" "RESTORE_THRESHOLDS_ON_BAT=1" /etc/tlp.conf
fi


