#!/usr/bin/env bash
set -euo pipefail
trap 'echo "FAILED at line $LINENO: $BASH_COMMAND" >&2' ERR

# Script outlasts the sudo timestamp: cache credentials and keep them alive.
sudo -v
( while sleep 50; do sudo -n true; done ) &
SUDO_KEEPALIVE=$!
trap 'kill $SUDO_KEEPALIVE 2>/dev/null' EXIT

# INSTALL OPTIONS
update_only=false
update_only_answer=
read -rp "Update only? (Y/n): " update_only_answer || true
if [[ $update_only_answer != [nN] ]] then
  update_only=true
fi

gaming=false
work=false
tablet=false
device=
read -rp "Gaming, work or tablet? (g/w/t): " device || true
if [[ $device == [gG] ]] then
  gaming=true
elif [[ $device == [wW] ]] then
  work=true
elif [[ $device == [tT] ]] then
  tablet=true
else
  echo "No device chosen, exiting"
  exit 1
fi

portable=false
if [[ $work == true || $tablet == true ]] then
  portable=true
fi


# FUNCTIONS
function install_appimage {
  # install_appimage(user, repo, package)
  local user=$1 repo=$2 package=$3

  local local_dir=~/Applications/

  if compgen -G "$local_dir$package*.AppImage" > /dev/null; then
    return
  fi

  local api_url=https://api.github.com/repos/$user/$repo/releases/latest

  local browser_download_url name
  browser_download_url=$(curl -fsSL "$api_url" | jq -r '.assets[] | select(.name | endswith(".AppImage")) | .browser_download_url' | head -n1)
  name=${browser_download_url##*/}
  if [[ -z $browser_download_url ]]; then
    echo "No AppImage found for $user/$repo" >&2
    return 1
  fi
  echo "Downloading $browser_download_url"
  curl -fLo "$local_dir$name" "$browser_download_url" --create-dirs
  chmod +x "$local_dir$name"
}


# MAINTENANCE
sudo pacman -Syu --needed --noconfirm
sudo pacman -S --needed --noconfirm git


if [[ $update_only == false ]] && ! command -v paru >/dev/null; then
  # AUR
  tmpdir=$(mktemp -d)
  git clone https://aur.archlinux.org/paru-bin.git "$tmpdir/paru-bin"
  cd "$tmpdir/paru-bin/"
  makepkg -si --needed --noconfirm
  cd /
  rm -rf "$tmpdir"
fi


# BASE
paru -S --needed --noconfirm sd # bootstrap: sd configs below need it
sudo sd "#Color" "Color" /etc/pacman.conf
sudo sd "#ParallelDownloads" "ParallelDownloads" /etc/pacman.conf
BASE_PKGS=(
  linux-headers
  linux-lts-headers
  man-db
  fish
  # vim
  grub-btrfs
  snapper
  snap-pac
  inotify-tools
  plocate
  fastfetch
  ventoy-bin
  fwupd
  reflector
  calc
)
paru -S --needed --noconfirm "${BASE_PKGS[@]}"
sudo sd GRUB_DEFAULT=0 GRUB_DEFAULT=saved /etc/default/grub
sudo sd \#GRUB_SAVEDEFAULT=true GRUB_SAVEDEFAULT=true /etc/default/grub
sudo grub-mkconfig -o /boot/grub/grub.cfg
# Input tweaks live in /etc so xf86-input-libinput upgrades cannot revert them
# (40-libinput.conf in /usr/share is package-owned).
# Mice stay at the libinput default (traditional scrolling); only the touchpad
# scrolls naturally - do not add a MatchIsPointer section, it catches the mice.
sudo tee /etc/X11/xorg.conf.d/50-scroll.conf >/dev/null <<'EOF'
Section "InputClass"
    Identifier "touchpad natural scrolling"
    MatchIsTouchpad "on"
    MatchDevicePath "/dev/input/event*"
    Driver "libinput"
    Option "NaturalScrolling" "true"
    Option "Tapping" "on"
EndSection
EOF
if [[ $update_only == false ]] then
  chsh -s "$(command -v fish)" "$USER"
fi
sudo sd "fsck\)" "fsck grub-btrfs-overlayfs)" /etc/mkinitcpio.conf
sudo systemctl enable grub-btrfsd.service
sudo systemctl start grub-btrfsd.service
sudo snapper -c root create-config /
sudo snapper -c root create --description fresh
sudo sd "# --country France,Germany" -- "--country Denmark,Sweden,Netherlands" /etc/xdg/reflector/reflector.conf
sudo sd "latest 5" "latest 10" /etc/xdg/reflector/reflector.conf
sudo sd "sort age" "sort rate" /etc/xdg/reflector/reflector.conf
sudo systemctl enable reflector.timer
sudo systemctl start reflector.service reflector.timer

# REMOTE ACCESS (personal tailnet, Tailscale SSH)
# Install + enable always (safe). Login only on non-work to avoid
# overwriting headscale mesh (one tailscaled = one active tailnet).
REMOTE_PKGS=(
  tailscale
  openssh
)
paru -S --needed --noconfirm "${REMOTE_PKGS[@]}"
sudo systemctl enable --now tailscaled
if [[ $work == false ]]; then
  if tailscale status &>/dev/null; then
    sudo tailscale set --ssh=true --operator=$USER
  else
    sudo tailscale up --ssh --operator=$USER
  fi
fi

## desktop
DESKTOP_PKGS=(
  i3-wm
  autotiling
  perl-anyevent-i3
  xlayoutdisplay
  redshift
  brightnessctl
  picom
  dunst
  alacritty
  mpv
  scrot
  loupe
  gnome-calculator
  gnome-screenshot
  gpu-screen-recorder-ui
  xclip
  # gnome-shell-extension-dash-to-panel
  nautilus
  evince
  # popsicle-bin
  pizarra-bin
