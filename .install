    bats-file
    bats-support
    tailscale
    ## universal robots
    docker
    docker-buildx
    docker-compose
    ## virtual machine
    qemu-desktop
    libvirt
    virt-manager
    dnsmasq
    iptables-nft
    mate-polkit
    # google drive
    opam
